# PROCHAINE ECHEANCE (A3) — le plus proche des instants futurs ou le jugement
# d'une derive OUVERTE peut changer sans qu'aucun fait nouveau n'arrive :
#   (a) fin de l'horizon de convergence d'une derive ouverte
#       (suspectee -> confirmee) : firstDetectedAt + horizon ;
#   (b) peremption d'un temoin : :lastWitnessRenewTime + :freshnessHorizon
#       (-> inconnu) ; sans temoin, :lastSyncTime + __VALIDITY__.
# Une seconde de marge : les verdicts testent age < horizon et age > seuil
# (comparaisons strictes, age en secondes entieres).
# Aucun resultat = aucune echeance utile (rien d'ouvert, ou deja tout perime).
# Le calcul de la date est ICI, pas dans le code Go.
# Entrees : <…/graph/history> et <…/graph/facts>. __NOW__, __VALIDITY__ : executeur.
PREFIX :    <https://w3id.org/sylvatwin/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT (MIN(?at) AS ?echeance) WHERE {
  BIND ("__NOW__"^^xsd:dateTime AS ?now)
  {
    GRAPH <https://w3id.org/sylvatwin/graph/history> {
      ?d :firstDetectedAt ?first ; :convergenceHorizon ?h .
      FILTER NOT EXISTS { ?d :resolvedAt ?r }
    }
    BIND (?first + xsd:dayTimeDuration(CONCAT("PT", STR(xsd:integer(CEIL(?h)) + 1), "S")) AS ?at)
  } UNION {
    # la fraicheur n'a d'effet que s'il existe une derive ouverte a juger
    FILTER EXISTS { GRAPH <https://w3id.org/sylvatwin/graph/history> {
      ?d2 :firstDetectedAt ?f2 . FILTER NOT EXISTS { ?d2 :resolvedAt ?r2 } } }
    GRAPH <https://w3id.org/sylvatwin/graph/facts> {
      ?kc a :KubernetesCluster .
      { ?kc :lastWitnessRenewTime ?u ; :freshnessHorizon ?th . BIND (?u AS ?ref) BIND (?th AS ?lim) }
      UNION
      { ?kc :lastSyncTime ?u2 . FILTER NOT EXISTS { ?kc :lastWitnessRenewTime ?x }
        BIND (?u2 AS ?ref) BIND (__VALIDITY__ AS ?lim) }
    }
    BIND (?ref + xsd:dayTimeDuration(CONCAT("PT", STR(xsd:integer(CEIL(?lim)) + 1), "S")) AS ?at)
  }
  FILTER (?at > ?now)
}
