# JUGE — S1 : PlacementDrift. Concerne le Pod mal place ET son Deployment.
PREFIX :    <https://w3id.org/sylvatwin/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
CONSTRUCT {
  ?drift a :PlacementDrift ; :affects ?pod , ?deployment , ?node ; :detectedAt ?now .
} WHERE {
  ?pod a :Pod ; :runsOn ?node ; :ownedBy+ ?deployment .
  ?deployment a :Deployment ; :requiresNodeLabel ?req .
  ?req :hasKey ?k ; :hasValue ?v .
  FILTER NOT EXISTS { ?node :hasLabel ?l . ?l :hasKey ?k ; :hasValue ?v . }
  BIND (NOW() AS ?now)
  BIND (IRI(CONCAT("https://w3id.org/sylvatwin/drift/PlacementDrift/", REPLACE(STR(?pod), "^https://w3id.org/sylvatwin/(res|drift)/", ""))) AS ?drift)
}
