# CQ4 (S2) — Quels Deployments referencent un Secret qui n'existe pas dans le
# cluster ? Indique aussi si le Secret etait gere par Flux.
# ATTENTION : on teste l'ABSENCE DE :uid (fait que seul le greffier ecrit quand
# il VOIT le Secret), pas l'absence de rdf:type :Secret. Un raisonneur OWL deduit
# le type depuis la portee de :referencesSecret, meme pour un Secret disparu.
PREFIX :    <https://w3id.org/sylvatwin/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?deployment ?secret ?nomSecret WHERE {
  ?deployment a :Deployment ; :referencesSecret ?secret .
  FILTER NOT EXISTS { ?secret :uid ?u }
  BIND (REPLACE(STR(?secret), "^.*/", "") AS ?nomSecret)
}
