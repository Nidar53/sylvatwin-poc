@prefix :        <https://w3id.org/sylvatwin/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# =============================================================================
# SylvaTwin — ontologie MINIMALE (version A), v1.1.0 : toutes les couches
#
#   L1 Cluster API   : KubernetesCluster, Cluster, Machine
#   L2 Kubernetes    : Namespace, Deployment, ReplicaSet, Pod, Node, Secret, Label
#   L3 GitOps Flux   : GitRepository, Kustomization, HelmRelease
#   L4 Fonctions 5G  : NetworkFunction (+ sous-classes 3GPP), NetworkInterface, PLMN, Slice
#   Transverse       : Drift (+ sous-classes), ecrit uniquement par le juge
#
# v1.0.0 -> v1.1.0 : ajouts seulement (aucun terme v1.0.0 retire ni redefini).
# v1.1.0 -> v1.2.0 : ajouts seulement (synchronisation : portee d'observation,
#   parametres Flux, cycle de vie des derives). Commentaire de :clusterName corrige.
# v1.2.0 -> v1.3.0 : ajouts seulement (Watch temoin, age de l'information,
#   horizon de ConvergenceDrift corrige, ConfigMap + StaleConfigDrift (D4), SCP).
#
# Fichier NOUVEAU. Il ne remplace pas sylvatwin-slice-v0.ttl, garde pour
# comparaison. Espace de noms DIFFERENT (…/core#) : les deux fichiers peuvent
# etre charges ensemble sans collision (dans v0, requiresNodeLabel est une
# DatatypeProperty ; ici c'est une ObjectProperty).
#
# Decisions appliquees (08/11/2026) :
#   D1  IRI des individus : https://w3id.org/sylvatwin/res/<cluster>/<namespace>/<Kind>/<nom>
#       objets sans namespace : segment fixe "_"  (ex. …/<cluster>/_/Node/<nom>)
#       l'uid Kubernetes est une simple data property (:uid).
#       D1-bis (v1.1.0, a valider) : pour les CRD, le segment <Kind> vaut
#       <Kind>.<groupe> (ex. Cluster.cluster.x-k8s.io). Raison observee : dans le
#       management, fleet-default/c-tfk7r existe a la fois en Cluster
#       provisioning.cattle.io et en Cluster fleet.cattle.io. Natifs (core, apps) :
#       <Kind> seul, inchange.
#       Entites non Kubernetes : KubernetesCluster = .../res/<cluster> ;
#       NetworkFunction = .../res/<cluster>/<ns>/NetworkFunction/<nom> ;
#       NetworkInterface = <IRI de la NF>/interface/<nom> ;
#       PLMN = .../res/_/PLMN/<mcc>-<mnc> ; Slice = .../res/_/Slice/sst-<sst>[-sd-<sd>].
#   D2  ReplicaSet = classe a part entiere ; Pod -> ReplicaSet -> Deployment
#       uniquement via metadata.ownerReferences (:ownedBy), jamais via le label app.
#   D3  Replicas : TROIS valeurs sur le meme individu (Option C etendue)
#       Git (:desiredReplicas) / spec observee (:observedSpecReplicas) /
#       status observe (:actualReplicas).
#   D4  Cote desire = GitRepository Flux reel (:desiredRevision = "test@sha1:…").
#   Labels structures : classe :Label avec :hasKey / :hasValue.
#
# Separation greffier / juge :
#   - annotation :writtenBy "greffier" : fait brut ecrit par l'operateur ;
#   - annotation :writtenBy "juge"     : ecrit UNIQUEMENT par les regles
#     (SHACL/SPARQL). L'operateur n'ecrit jamais une classe Drift ni :affects.
#
# Scenarios : S0 = replicas (ConfigurationDrift), S1 = placement (PlacementDrift),
#             S2 = reference a un Secret cassee (BrokenReferenceDrift),
#             S3 = impact inter-couches sur une NF (FunctionImpactDrift),
#             S4 = incoherence entre NF : PLMN, tranche (InterNFConsistencyDrift),
#             S5 = livraison GitOps bloquee (GitOpsSyncDrift),
#             S6 = Machine CAPI <-> Node incoherents (MachineNodeMismatchDrift).
# Regles : dossier rules/ (SPARQL). Ordre : rules/derives/0*.rq, puis 10-*.rq,
# puis 11-*.rq (11 propage l'impact trouve par 10).
#
# LIMITE DU BANC (a citer dans la these) : pas d'UPF, pas de gNB, pas d'UE, donc
# aucun trafic ; NGAP (N2), PFCP (N4) et GTP-U sont lies a 127.0.0.1 et
# injoignables hors de leur pod. La couche L4 modelise la configuration et les
# dependances declarees, pas un service 5G en fonctionnement.
# =============================================================================

<https://w3id.org/sylvatwin/core> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/sylvatwin/core/1.3.0> ;
    owl:versionInfo "1.3.0" ;
    dcterms:title "SylvaTwin — ontologie minimale (version A) : Cluster API, Kubernetes, Flux, fonctions 5G"@fr ;
    dcterms:creator "Ahmed Nidhar Sebihi" ;
    dcterms:created "2026-11-08"^^xsd:date ;
    rdfs:comment """Version minimale de bout en bout : le minimum de chaque couche (L1 Cluster API,
L2 Kubernetes, L3 Flux, L4 fonctions reseau) pour que les ponts entre couches
existent. La version complete (B) prolongera ces classes sans les modifier."""@fr ;
    rdfs:seeAlso <https://w3id.org/sylvatwin/k8s> .

# -----------------------------------------------------------------------------
# Annotations de documentation (aucun effet logique)
# -----------------------------------------------------------------------------
dcterms:title   a owl:AnnotationProperty .
dcterms:creator a owl:AnnotationProperty .
dcterms:created a owl:AnnotationProperty .

:usedInScenario a owl:AnnotationProperty ;
    rdfs:label "utilise dans le scenario"@fr ;
    rdfs:comment "Scenario(s) de derive qui ont besoin de ce terme : S0 a S6 (voir l'en-tete)."@fr .

:layer a owl:AnnotationProperty ;
    rdfs:label "couche"@fr ;
    rdfs:comment "Couche du jumeau : L1 (Cluster API), L2 (Kubernetes), L3 (Flux), L4 (fonctions reseau) ou transverse."@fr .

:writtenBy a owl:AnnotationProperty ;
    rdfs:label "ecrit par"@fr ;
    rdfs:comment """Qui a le droit d'ecrire ce terme dans le graphe : "greffier" (l'operateur,
faits observes ou lus dans Git) ou "juge" (les regles de detection)."""@fr .

:k8sSource a owl:AnnotationProperty ;
    rdfs:label "source Kubernetes"@fr ;
    rdfs:comment "Champ Kubernetes ou Git d'ou le greffier tire la valeur."@fr .

# =============================================================================
# 1. CLASSES DU DOMAINE (ecrites par le greffier)
# =============================================================================

:KubernetesResource a owl:Class ;
    rdfs:label "ressource Kubernetes"@fr , "Kubernetes resource"@en ;
    rdfs:comment """Parent commun de tous les objets Kubernetes du jumeau. Porte ce que tout objet
possede : son cluster, son nom, son uid, son namespace et l'instant ou on l'a observe.
Un individu de cette classe qui a un :uid a ete VU dans le cluster ; sans :uid, on
sait seulement que quelque chose le reference (utile pour S2)."""@fr ;
    :usedInScenario "S0" , "S1" , "S2" ;
    :writtenBy "greffier" .

:Namespace a owl:Class ; rdfs:subClassOf :KubernetesResource ;
    rdfs:label "namespace"@fr , "Namespace"@en ;
    rdfs:comment """Espace de noms Kubernetes. Sert a distinguer deux objets de meme nom (par
exemple deux Deployments "coredns" dans deux namespaces ou deux clusters).
Il n'a pas lui-meme de namespace : IRI …/<cluster>/_/Namespace/<nom>."""@fr ;
    :usedInScenario "S0" , "S1" , "S2" ;
    :writtenBy "greffier" .

:Deployment a owl:Class ; rdfs:subClassOf :KubernetesResource ;
    rdfs:label "Deployment"@fr , "Deployment"@en ;
    rdfs:comment """L'objet declare dans Git qui porte l'intention : le nombre de replicas (S0),
l'exigence de placement nodeSelector (S1) et les Secrets dont ses pods ont
besoin (S2). C'est le seul individu qui porte les trois valeurs de replicas."""@fr ;
    :usedInScenario "S0" , "S1" , "S2" ;
    :writtenBy "greffier" .

:ReplicaSet a owl:Class ; rdfs:subClassOf :KubernetesResource ;
    rdfs:label "ReplicaSet"@fr , "ReplicaSet"@en ;
    rdfs:comment """Le maillon reel entre un Pod et son Deployment. Kubernetes l'ecrit dans les
ownerReferences : Pod -> ReplicaSet -> Deployment. Le garder dans le graphe evite
de deviner le Deployment par un label (le label "app" n'existe pas sur les pods
Open5GS). Les anciens ReplicaSets a 0 replica restent visibles (historique des
deploiements)."""@fr ;
    :usedInScenario "S1" ;
    :writtenBy "greffier" .

:Pod a owl:Class ; rdfs:subClassOf :KubernetesResource ;
    rdfs:label "Pod"@fr , "Pod"@en ;
    rdfs:comment """Ce qui tourne vraiment, a un endroit precis. N'existe que du cote observe :
Git ne decrit jamais un Pod. Pour S1, c'est le Pod (pas le Deployment) qui est
mal place."""@fr ;
    :usedInScenario "S1" ;
    :writtenBy "greffier" .

:Node a owl:Class ; rdfs:subClassOf :KubernetesResource ;
    rdfs:label "noeud"@fr , "Node"@en ;
    rdfs:comment """La machine sur laquelle tournent les pods (en CAPD : un conteneur Docker).
Elle n'est pas decrite dans Git ; seuls ses labels observes comptent pour S1.
Pas de namespace : IRI …/<cluster>/_/Node/<nom>."""@fr ;
    :usedInScenario "S1" ;
    :writtenBy "greffier" .

:Secret a owl:Class ; rdfs:subClassOf :KubernetesResource ;
    rdfs:label "Secret"@fr , "Secret"@en ;
    rdfs:comment """Un Secret Kubernetes. Le jumeau n'en stocke JAMAIS le contenu : seulement son
existence (uid, observedAt). Pour S2, la question est : un Deployment reference-t-il
un Secret qui n'a pas (ou plus) d'existence observee ?"""@fr ;
    :usedInScenario "S2" ;
    :writtenBy "greffier" .

:Label a owl:Class ;
    rdfs:label "label"@fr , "Label"@en ;
    rdfs:comment """Un couple cle/valeur, structure (:hasKey, :hasValue) au lieu de la chaine
"cle=valeur" de la v0. Les regles comparent la cle et la valeur, jamais l'IRI du
Label : le cote Git (nodeSelector) et le cote cluster (labels du noeud) n'ont plus
besoin de partager une convention d'ecriture. Un Label n'est pas une ressource
Kubernetes : il appartient a un objet (IRI …/<objet>/label/<cle encodee> ou
…/<objet>/nodeSelector/<cle encodee>)."""@fr ;
    :usedInScenario "S1" ;
    :writtenBy "greffier" .

[] a owl:AllDisjointClasses ;
    owl:members ( :Namespace :Deployment :ReplicaSet :Pod :Node :Secret ) .

:Label owl:disjointWith :KubernetesResource .

# =============================================================================
# 2. CLASSES DE DERIVE (ecrites UNIQUEMENT par le juge)
# =============================================================================

:Drift a owl:Class ;
    rdfs:label "derive"@fr , "Drift"@en ;
    rdfs:comment """Ecart constate par une regle entre l'etat desire et l'etat observe. Jamais ecrit
par l'operateur : c'est le resultat d'une regle SHACL ou SPARQL."""@fr ;
    owl:disjointWith :KubernetesResource , :Label ;
    :usedInScenario "S0" , "S1" , "S2" ;
    :writtenBy "juge" .

:ConfigurationDrift a owl:Class ; rdfs:subClassOf :Drift ;
    rdfs:label "derive de configuration"@fr , "Configuration drift"@en ;
    rdfs:comment """S0 : le nombre de replicas n'est pas le meme partout. Deux sous-cas distincts,
grace aux trois valeurs portees par le Deployment."""@fr ;
    :usedInScenario "S0" ;
    :writtenBy "juge" .

:SpecDrift a owl:Class ; rdfs:subClassOf :ConfigurationDrift ;
    rdfs:label "spec modifiee a la main"@fr , "Spec drift"@en ;
    rdfs:comment """S0, cas A : la spec du cluster ne correspond plus a Git
(desiredReplicas != observedSpecReplicas). Exemple : quelqu'un a fait
"kubectl scale". Flux la corrigera a son prochain intervalle."""@fr ;
    :usedInScenario "S0" ;
    :writtenBy "juge" .

:ConvergenceDrift a owl:Class ; rdfs:subClassOf :ConfigurationDrift ;
    rdfs:label "Kubernetes n'a pas converge"@fr , "Convergence drift"@en ;
    rdfs:comment """S0, cas B : la spec est conforme a Git, mais le cluster n'atteint pas ce qu'elle
demande (observedSpecReplicas != actualReplicas). Exemple : un pod ne peut pas etre
cree ou planifie. Flux ne voit rien : la spec est conforme. Une regle doit tolerer
les ecarts transitoires (deploiement en cours) : c'est le role du verdict date."""@fr ;
    :usedInScenario "S0" ;
    :writtenBy "juge" .

:PlacementDrift a owl:Class ; rdfs:subClassOf :Drift ;
    rdfs:label "derive de placement"@fr , "Placement drift"@en ;
    rdfs:comment """S1 : un Pod tourne sur un noeud qui ne porte plus un label exige par le
nodeSelector de son Deployment. Kubernetes n'evince pas le pod ; Flux ne regarde
pas les noeuds. Derive inter-couches (workload <-> infrastructure)."""@fr ;
    :usedInScenario "S1" ;
    :writtenBy "juge" .

:BrokenReferenceDrift a owl:Class ; rdfs:subClassOf :Drift ;
    rdfs:label "reference cassee"@fr , "Broken reference drift"@en ;
    rdfs:comment """S2 : un Deployment reference un Secret qui n'existe pas dans le cluster. Le pod
qui tourne deja continue ; il ne pourra plus redemarrer. Si le Secret est hors
Git (cas de udm-keys), ni Flux ni kubectl diff ne le voient."""@fr ;
    :usedInScenario "S2" ;
    :writtenBy "juge" .

# =============================================================================
# 3. OBJECT PROPERTIES
# =============================================================================

:inNamespace a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "dans le namespace"@fr ;
    rdfs:domain :KubernetesResource ;
    rdfs:range :Namespace ;
    rdfs:comment "Namespace de l'objet. Absent pour les objets sans namespace (Node, Namespace)."@fr ;
    :k8sSource "metadata.namespace" ;
    :usedInScenario "S0" , "S1" , "S2" ;
    :writtenBy "greffier" .

:ownedBy a owl:ObjectProperty ;
    rdfs:label "appartient a"@fr ;
    rdfs:domain :KubernetesResource ;
    rdfs:range :KubernetesResource ;
    rdfs:comment """Copie fidele de metadata.ownerReferences : Pod -> ReplicaSet et
ReplicaSet -> Deployment. Le Deployment d'un Pod s'obtient par le chemin
SPARQL ":ownedBy+", sans raisonneur. Domaine et portee volontairement generiques :
dans Kubernetes, le proprietaire peut etre un Node (pods statiques de kube-system),
un Job, un StatefulSet… Une portee plus etroite ferait conclure a tort qu'un Node
est un ReplicaSet."""@fr ;
    :k8sSource "metadata.ownerReferences[].{kind,name}" ;
    :usedInScenario "S1" ;
    :writtenBy "greffier" .

:runsOn a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tourne sur"@fr ;
    rdfs:domain :Pod ;
    rdfs:range :Node ;
    rdfs:comment """Le noeud sur lequel le Pod a ete place. Absent si le Pod n'est pas encore
planifie (Pending) : un pod non place n'est pas mal place. Relation inter-couches
au coeur de S1."""@fr ;
    :k8sSource "Pod.spec.nodeName" ;
    :usedInScenario "S1" ;
    :writtenBy "greffier" .

:hasLabel a owl:ObjectProperty ;
    rdfs:label "porte le label"@fr ;
    rdfs:domain :KubernetesResource ;
    rdfs:range :Label ;
    rdfs:comment """Label OBSERVE sur un objet du cluster. En version A, seul celui des Nodes sert
(S1). Le greffier ecrit tous les labels, sans filtrer : filtrer, ce serait deja juger."""@fr ;
    :k8sSource "metadata.labels" ;
    :usedInScenario "S1" ;
    :writtenBy "greffier" .

:requiresNodeLabel a owl:ObjectProperty ;
    rdfs:label "exige le label de noeud"@fr ;
    rdfs:domain :Deployment ;
    rdfs:range :Label ;
    rdfs:comment """Exigence de placement DECLAREE dans Git : chaque entree du nodeSelector du
pod template devient un Label. S1 compare ces Labels (cle et valeur) a ceux du
noeud sur lequel tourne chaque Pod."""@fr ;
    :k8sSource "Git : Deployment.spec.template.spec.nodeSelector" ;
    :usedInScenario "S1" ;
    :writtenBy "greffier" .

:referencesSecret a owl:ObjectProperty ;
    rdfs:label "reference le Secret"@fr ;
    rdfs:domain :Deployment ;
    rdfs:range :Secret ;
    rdfs:comment """Le pod template du Deployment a besoin de ce Secret (volume, env, envFrom,
imagePullSecrets). Le triplet est ecrit a partir du Deployment, qu'il existe ou
non un Secret de ce nom. ATTENTION : a cause de la portee, un raisonneur deduira
"rdf:type :Secret" pour la cible meme si le Secret n'existe pas. La regle S2 doit
donc tester l'absence de :uid (fait que seul le greffier ecrit quand il VOIT le
Secret), jamais l'absence du type."""@fr ;
    :k8sSource "Deployment.spec.template.spec.{volumes[].secret.secretName, containers[].env[].valueFrom.secretKeyRef.name, containers[].envFrom[].secretRef.name, imagePullSecrets[].name}" ;
    :usedInScenario "S2" ;
    :writtenBy "greffier" .

:affects a owl:ObjectProperty ;
    rdfs:label "concerne"@fr ;
    rdfs:domain :Drift ;
    rdfs:range :KubernetesResource ;
    rdfs:comment "Ressource(s) concernee(s) par une derive. Ecrit uniquement par les regles."@fr ;
    :usedInScenario "S0" , "S1" , "S2" ;
    :writtenBy "juge" .

# =============================================================================
# 4. DATA PROPERTIES
# =============================================================================

# --- identite et fraicheur (tout objet) --------------------------------------
:clusterName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nom du cluster"@fr ;
    rdfs:domain :KubernetesResource ;
    rdfs:range xsd:string ;
    rdfs:comment """Cluster ou se trouve l'objet (premier segment de l'IRI). Permet de filtrer
par cluster sans decouper les IRI. Le cluster lui-meme est l'individu :KubernetesCluster
(relie par :resourceInCluster), decrit par l'objet Cluster API :Cluster (:clusterDescribedBy)."""@fr ;
    :k8sSource "contexte du greffier (nom du Cluster CAPI)" ;
    :usedInScenario "S0" , "S1" , "S2" ;
    :writtenBy "greffier" .

:resourceName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nom"@fr ;
    rdfs:domain :KubernetesResource ;
    rdfs:range xsd:string ;
    rdfs:comment "metadata.name, recopie pour les requetes et l'affichage."@fr ;
    :k8sSource "metadata.name" ;
    :usedInScenario "S0" , "S1" , "S2" ;
    :writtenBy "greffier" .

:uid a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "uid"@fr ;
    rdfs:domain :KubernetesResource ;
    rdfs:range xsd:string ;
    rdfs:comment """metadata.uid. N'est PAS l'identifiant de l'individu (Git ne connait pas l'uid).
Sa presence signifie : "cet objet a ete vu dans le cluster". Son absence sur un
objet reference est le signal de S2. Un uid qui change a nom egal revele un objet
supprime puis recree."""@fr ;
    :k8sSource "metadata.uid" ;
    :usedInScenario "S2" ;
    :writtenBy "greffier" .

:observedAt a owl:DatatypeProperty ;
    rdfs:label "observe a"@fr ;
    rdfs:domain :KubernetesResource ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Instant ou le greffier a observe l'objet. Sert au verdict date (age de l'information)."@fr ;
    :usedInScenario "S0" , "S1" , "S2" ;
    :writtenBy "greffier" .

:desiredRevision a owl:DatatypeProperty ;
    rdfs:label "revision Git du desire"@fr ;
    rdfs:domain :KubernetesResource ;
    rdfs:range xsd:string ;
    rdfs:comment """Revision Git desiree. Sur un objet deploye (Deployment) : revision du GitRepository
d'ou viennent ses valeurs desirees, par exemple "test@sha1:39f14ded…". Sur une
Kustomization : revision de sa source (moitie "desire" de la paire Option C avec
:actualRevision, S5). Sur une HelmRelease : revision de l'artefact de chart.
Tracabilite : la derive pointe vers un commit precis."""@fr ;
    :k8sSource "GitRepository.status.artifact.revision (Kustomization, Deployment) ; HelmChart.status.artifact.revision (HelmRelease)" ;
    :usedInScenario "S0" , "S1" , "S5" ;
    :writtenBy "greffier" .

# --- replicas : trois valeurs sur le meme individu (Option C etendue) ---------
:desiredReplicas a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "replicas desires (Git)"@fr ;
    rdfs:domain :Deployment ;
    rdfs:range xsd:integer ;
    rdfs:comment """Valeur 1 sur 3 : spec.replicas tel qu'ecrit dans Git, a la revision
:desiredRevision (1 si le champ est absent, comme le fait Kubernetes). S0."""@fr ;
    :k8sSource "Git : Deployment.spec.replicas" ;
    :usedInScenario "S0" ;
    :writtenBy "greffier" .

:observedSpecReplicas a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "replicas demandes dans le cluster (spec observee)"@fr ;
    rdfs:domain :Deployment ;
    rdfs:range xsd:integer ;
    rdfs:comment """Valeur 2 sur 3 : spec.replicas tel qu'il est dans le cluster. Different de
:desiredReplicas => la spec a ete modifiee hors Git (SpecDrift, S0 cas A)."""@fr ;
    :k8sSource "Deployment.spec.replicas" ;
    :usedInScenario "S0" ;
    :writtenBy "greffier" .

:actualReplicas a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "replicas reellement prets (status observe)"@fr ;
    rdfs:domain :Deployment ;
    rdfs:range xsd:integer ;
    rdfs:comment """Valeur 3 sur 3 : nombre de pods PRETS, status.readyReplicas (0 si absent).
Different de :observedSpecReplicas => Kubernetes n'a pas converge (ConvergenceDrift,
S0 cas B). Changement par rapport a v0, qui lisait status.replicas : ce compteur
inclut les pods Pending et masquerait une non-convergence."""@fr ;
    :k8sSource "Deployment.status.readyReplicas" ;
    :usedInScenario "S0" ;
    :writtenBy "greffier" .

# --- Pod ----------------------------------------------------------------------
:podPhase a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "phase du pod"@fr ;
    rdfs:domain :Pod ;
    rdfs:range xsd:string ;
    rdfs:comment """Pending, Running, Succeeded, Failed ou Unknown. Aide a expliquer une
ConvergenceDrift (pods Pending) et a ignorer les pods termines en S1."""@fr ;
    :k8sSource "Pod.status.phase" ;
    :usedInScenario "S0" , "S1" ;
    :writtenBy "greffier" .

# --- Label --------------------------------------------------------------------
:hasKey a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "cle"@fr ;
    rdfs:domain :Label ;
    rdfs:range xsd:string ;
    rdfs:comment "Cle du label, par exemple \"kubernetes.io/os\" ou \"sylvatwin.orange.com/zone\". S1."@fr ;
    :usedInScenario "S1" ;
    :writtenBy "greffier" .

:hasValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "valeur"@fr ;
    rdfs:domain :Label ;
    rdfs:range xsd:string ;
    rdfs:comment "Valeur du label (chaine vide autorisee, ex. node-role.kubernetes.io/control-plane). S1."@fr ;
    :usedInScenario "S1" ;
    :writtenBy "greffier" .

# --- Drift --------------------------------------------------------------------
:detectedAt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "detecte a"@fr ;
    rdfs:domain :Drift ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Instant ou la regle a constate la derive. Ecrit uniquement par les regles."@fr ;
    :usedInScenario "S0" , "S1" , "S2" ;
    :writtenBy "juge" .

# #############################################################################
# v1.1.0 — COUCHES L1 (Cluster API), L3 (Flux), L4 (fonctions reseau)
# Les classes et proprietes ci-dessus (v1.0.0) forment la couche L2 et restent
# inchangees. Tout ce qui suit est un AJOUT.
# #############################################################################

# =============================================================================
# 5. FAMILLE "CRD" : classe parente
# =============================================================================

:CustomResource a owl:Class ; rdfs:subClassOf :KubernetesResource ;
    rdfs:label "ressource personnalisee (CRD)"@fr , "Custom resource"@en ;
    rdfs:comment """Parent des objets definis par une CRD (Cluster API, Flux). Ce sont bien des objets
Kubernetes (ils ont un uid, un namespace, et vivent dans un cluster), mais ils
decrivent ou pilotent d'autres objets. Les separer des ressources natives rend
explicites les ponts entre les deux familles (:machineHasNode, :managedBy…).
Disjointe des classes natives."""@fr ;
    :layer "L1" , "L3" ;
    :usedInScenario "S5" , "S6" ;
    :writtenBy "greffier" .

[] a owl:AllDisjointClasses ;
    owl:members ( :CustomResource :Namespace :Deployment :ReplicaSet :Pod :Node :Secret ) .

:apiGroup a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "groupe d'API"@fr ;
    rdfs:domain :CustomResource ;
    rdfs:range xsd:string ;
    rdfs:comment """Groupe d'API de la CRD (cluster.x-k8s.io, kustomize.toolkit.fluxcd.io…). Lève
l'ambiguite entre CRD de meme Kind (sur ton management, 5 groupes definissent un
Kind "Cluster"). C'est aussi le suffixe du segment <Kind> de l'IRI (D1-bis)."""@fr ;
    :k8sSource "apiVersion (partie groupe)" ;
    :layer "L1" , "L3" ;
    :usedInScenario "S5" , "S6" ;
    :writtenBy "greffier" .

# =============================================================================
# 6. L1 — CLUSTER API (minimal)
# =============================================================================

:KubernetesCluster a owl:Class ;
    rdfs:label "cluster Kubernetes (reel)"@fr , "Kubernetes cluster"@en ;
    rdfs:comment """Le cluster REEL, tel qu'on l'observe par son API (ici : management-cluster et
my-workload-kubeadm-capd). Ce n'est pas un objet Kubernetes : c'est le conteneur
de tous les objets observes. IRI : .../res/<cluster>. Il fait le pont entre la
description CAPI (:clusterDescribedBy) et les objets qu'il contient
(:resourceInCluster), et sert de cible aux Kustomizations (:targetsCluster).
Ne JAMAIS lui donner :clusterName, :uid ou :observedAt : leur domaine est
KubernetesResource, et un raisonneur en conclurait que le cluster est une ressource
(incoherence avec la disjonction). Son nom est dans l'IRI et rdfs:label."""@fr ;
    owl:disjointWith :KubernetesResource ;
    :layer "L1" ;
    :usedInScenario "S5" , "S6" ;
    :writtenBy "greffier" .

:Cluster a owl:Class ; rdfs:subClassOf :CustomResource ;
    rdfs:label "Cluster (objet Cluster API)"@fr , "Cluster API Cluster"@en ;
    rdfs:comment """L'objet Cluster de Cluster API (cluster.x-k8s.io), qui vit dans le cluster de
MANAGEMENT et DECRIT un cluster (souvent un autre : le workload). Ne pas confondre
avec :KubernetesCluster, le cluster reel. Dans Sylva, il est lui-meme produit par
une HelmRelease Flux ("cluster"), d'ou la chaine Git -> Flux -> CAPI."""@fr ;
    :k8sSource "clusters.cluster.x-k8s.io" ;
    :layer "L1" ;
    :usedInScenario "S6" ;
    :writtenBy "greffier" .

:Machine a owl:Class ; rdfs:subClassOf :CustomResource ;
    rdfs:label "Machine (Cluster API)"@fr , "Machine"@en ;
    rdfs:comment """Une machine declaree par Cluster API (ici : un conteneur CAPD). Elle vit dans le
cluster de management ; le Node qu'elle devient vit dans le cluster decrit. C'est
le pont L1 -> L2 (:machineHasNode). S6 compare ces deux mondes."""@fr ;
    :k8sSource "machines.cluster.x-k8s.io" ;
    :layer "L1" ;
    :usedInScenario "S6" ;
    :writtenBy "greffier" .

[] a owl:AllDisjointClasses ;
    owl:members ( :Cluster :Machine :GitRepository :Kustomization :HelmRelease ) .

:resourceInCluster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "se trouve dans le cluster"@fr ;
    rdfs:domain :KubernetesResource ;
    rdfs:range :KubernetesCluster ;
    rdfs:comment """Cluster reel ou l'objet a ete observe. Version objet de :clusterName : elle
permet de traverser les couches (Pod -> cluster -> Cluster CAPI -> Machines…).
Exemple : la Machine est dans le management, son Node est dans le workload."""@fr ;
    :k8sSource "contexte du greffier (kubeconfig utilise pour l'observation)" ;
    :layer "L1" , "L2" ;
    :usedInScenario "S5" , "S6" ;
    :writtenBy "greffier" .

:clusterDescribedBy a owl:ObjectProperty ;
    rdfs:label "est decrit par"@fr ;
    rdfs:domain :KubernetesCluster ;
    rdfs:range :Cluster ;
    rdfs:comment """Le cluster reel est decrit par cet objet Cluster API. Le greffier l'ecrit
quand l'endpoint de l'API observee correspond a Cluster.spec.controlPlaneEndpoint
(ici 172.30.0.2:6443 pour le workload)."""@fr ;
    :k8sSource "Cluster.spec.controlPlaneEndpoint = serveur du kubeconfig" ;
    :layer "L1" ;
    :usedInScenario "S6" ;
    :writtenBy "greffier" .

:machineOfCluster a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "machine du Cluster"@fr ;
    rdfs:domain :Machine ;
    rdfs:range :Cluster ;
    rdfs:comment """Le Cluster CAPI auquel appartient la Machine. Indispensable pour S6 : on
compare les Machines d'un Cluster aux Nodes du cluster reel qu'il decrit."""@fr ;
    :k8sSource "Machine.spec.clusterName (label cluster.x-k8s.io/cluster-name)" ;
    :layer "L1" ;
    :usedInScenario "S6" ;
    :writtenBy "greffier" .

:machineHasNode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "a pour noeud"@fr ;
    rdfs:domain :Machine ;
    rdfs:range :Node ;
    rdfs:comment """Pont L1 -> L2 : le Node que la Machine est devenue. Le greffier ne l'ecrit que
si Machine.status.nodeRef existe. Une Machine sans ce triplet, ou un Node
qu'aucune Machine ne revendique, est le signal de S6."""@fr ;
    :k8sSource "Machine.status.nodeRef.name" ;
    :layer "L1" ;
    :usedInScenario "S6" ;
    :writtenBy "greffier" .

:machinePhase a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "phase de la machine"@fr ;
    rdfs:domain :Machine ;
    rdfs:range xsd:string ;
    rdfs:comment """Pending, Provisioning, Provisioned, Running, Deleting, Failed… Permet a S6
d'ignorer une Machine encore en creation (pas de Node, c'est normal)."""@fr ;
    :k8sSource "Machine.status.phase" ;
    :layer "L1" ;
    :usedInScenario "S6" ;
    :writtenBy "greffier" .

# =============================================================================
# 7. L3 — GITOPS FLUX (minimal)
# =============================================================================

:GitRepository a owl:Class ; rdfs:subClassOf :CustomResource ;
    rdfs:label "GitRepository (source Flux)"@fr , "GitRepository"@en ;
    rdfs:comment """La source Git surveillee par Flux. Porte l'URL, la branche et la derniere
revision recuperee : c'est la reference "desiree" de toute la chaine."""@fr ;
    :k8sSource "gitrepositories.source.toolkit.fluxcd.io" ;
    :layer "L3" ;
    :usedInScenario "S5" ;
    :writtenBy "greffier" .

:Kustomization a owl:Class ; rdfs:subClassOf :CustomResource ;
    rdfs:label "Kustomization (Flux)"@fr , "Flux Kustomization"@en ;
    rdfs:comment """Ce que Flux applique depuis une source vers un cluster (a ne pas confondre
avec le fichier kustomization.yaml). Ici : sylvatwin-5gc, sur le management, qui
deploie le coeur 5G dans le workload. Porte la paire Option C
desiredRevision / actualRevision et l'etat suspended (S5)."""@fr ;
    :k8sSource "kustomizations.kustomize.toolkit.fluxcd.io" ;
    :layer "L3" ;
    :usedInScenario "S5" ;
    :writtenBy "greffier" .

:HelmRelease a owl:Class ; rdfs:subClassOf :CustomResource ;
    rdfs:label "HelmRelease (Flux)"@fr , "HelmRelease"@en ;
    rdfs:comment """Un chart Helm installe par Flux. Existe reellement : 57 HelmReleases sur le
management, dont "cluster" (namespace my-workload-kubeadm-capd) qui produit le
Cluster CAPI du workload ; c'est le lien Flux -> Cluster API. Aucune HelmRelease
pour le coeur 5G (il passe par une Kustomization)."""@fr ;
    :k8sSource "helmreleases.helm.toolkit.fluxcd.io" ;
    :layer "L3" ;
    :usedInScenario "S5" ;
    :writtenBy "greffier" .

:managedBy a owl:ObjectProperty ;
    rdfs:label "gere par"@fr ;
    rdfs:domain :KubernetesResource ;
    rdfs:range :CustomResource ;
    rdfs:comment """L'objet a ete cree par cette Kustomization ou HelmRelease. Source principale :
l'inventaire (Kustomization.status.inventory) ; a defaut, les labels poses par
Flux. Pont L3 -> L2 (Deployment udm) et L3 -> L1 (Cluster gere par la HelmRelease
"cluster"). Son ABSENCE sur un objet (udm-keys) dit "hors Git" : utile pour
expliquer S2. Portee volontairement large (CustomResource) : OWL ne sait pas
dire "Kustomization OU HelmRelease" en profil RL ; le controle est dans les regles."""@fr ;
    :k8sSource "Kustomization.status.inventory.entries[].id ; labels kustomize.toolkit.fluxcd.io/name, helm.toolkit.fluxcd.io/name" ;
    :layer "L3" ;
    :usedInScenario "S2" , "S5" ;
    :writtenBy "greffier" .

:sourcedFrom a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "a pour source"@fr ;
    rdfs:domain :Kustomization ;
    rdfs:range :GitRepository ;
    rdfs:comment """La Kustomization lit ses manifestes dans ce GitRepository. En version minimale,
seule une source GitRepository est modelisee (cas de sylvatwin-5gc)."""@fr ;
    :k8sSource "Kustomization.spec.sourceRef (kind GitRepository)" ;
    :layer "L3" ;
    :usedInScenario "S5" ;
    :writtenBy "greffier" .

:targetsCluster a owl:ObjectProperty ;
    rdfs:label "cible le cluster"@fr ;
    rdfs:domain :CustomResource ;
    rdfs:range :KubernetesCluster ;
    rdfs:comment """Cluster ou la Kustomization (ou la HelmRelease) applique ses objets : le cluster
local si spec.kubeConfig est vide, sinon celui du kubeconfig reference. Ici,
sylvatwin-5gc vit dans le management et cible le workload : c'est ce lien qui
permet de remonter de Flux jusqu'aux Pods d'un autre cluster."""@fr ;
    :k8sSource "spec.kubeConfig.secretRef -> serveur du kubeconfig (sinon cluster local)" ;
    :layer "L3" ;
    :usedInScenario "S5" ;
    :writtenBy "greffier" .

:actualRevision a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "revision Git reellement appliquee"@fr ;
    rdfs:domain :CustomResource ;
    rdfs:range xsd:string ;
    rdfs:comment """Moitie "observee" de la paire Option C (avec :desiredRevision) : revision que
Flux a effectivement appliquee. Different de :desiredRevision => la livraison
GitOps est bloquee ou en retard (S5). Absent tant que rien n'a ete applique."""@fr ;
    :k8sSource "Kustomization.status.lastAppliedRevision ; HelmRelease.status.history[0] (chartVersion)" ;
    :layer "L3" ;
    :usedInScenario "S5" ;
    :writtenBy "greffier" .

:suspended a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "suspendu"@fr ;
    rdfs:domain :CustomResource ;
    rdfs:range xsd:boolean ;
    rdfs:comment """Vrai si la reconciliation Flux est suspendue (spec.suspend). Une Kustomization
suspendue ne corrige plus rien : les derives S0 (cas A) ne sont plus reparees.
Le greffier ecrit false si le champ est absent."""@fr ;
    :k8sSource "spec.suspend" ;
    :layer "L3" ;
    :usedInScenario "S5" ;
    :writtenBy "greffier" .

:ready a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pret"@fr ;
    rdfs:domain :CustomResource ;
    rdfs:range xsd:boolean ;
    rdfs:comment """Condition Ready de l'objet Flux ou CAPI. Fait brut recopie, pas un jugement :
c'est le controleur Flux qui l'a ecrite."""@fr ;
    :k8sSource "status.conditions[type=Ready].status" ;
    :layer "L3" ;
    :usedInScenario "S5" ;
    :writtenBy "greffier" .

:gitUrl a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "URL Git"@fr ;
    rdfs:domain :GitRepository ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "URL du depot surveille."@fr ;
    :k8sSource "GitRepository.spec.url" ;
    :layer "L3" ;
    :usedInScenario "S5" ;
    :writtenBy "greffier" .

:gitBranch a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "branche Git"@fr ;
    rdfs:domain :GitRepository ;
    rdfs:range xsd:string ;
    rdfs:comment "Branche suivie (spec.ref.branch)."@fr ;
    :k8sSource "GitRepository.spec.ref.branch" ;
    :layer "L3" ;
    :usedInScenario "S5" ;
    :writtenBy "greffier" .

# =============================================================================
# 8. L4 — FONCTIONS RESEAU (version legere, sans N2/N3/N4 fins)
# =============================================================================

:NetworkFunction a owl:Class ;
    rdfs:label "fonction reseau (NF)"@fr , "Network function"@en ;
    rdfs:comment """Une fonction du coeur 5G (3GPP TS 23.501), vue comme entite logique, distincte
du Deployment qui la realise. C'est elle que l'operateur telecom regarde : une
derive Kubernetes n'a de sens metier que si on sait QUELLE NF elle touche (S3).
Le greffier l'ecrit a partir du label sylvatwin.orange.com/nf du Deployment et
lit sa configuration (PLMN, tranches, NRF) dans la ConfigMap montee.
LIMITE : le banc n'a ni UPF ni gNB ni UE, donc aucun trafic."""@fr ;
    owl:disjointWith :KubernetesResource , :KubernetesCluster ;
    :layer "L4" ;
    :usedInScenario "S3" , "S4" ;
    :writtenBy "greffier" .

:AMF  a owl:Class ; rdfs:subClassOf :NetworkFunction ; rdfs:label "AMF"@fr ;
    rdfs:comment "Access and Mobility Management Function. Deployee (NGAP lie a 127.0.0.1). Declare PLMN et tranches servis : sert S4."@fr ;
    :layer "L4" ; :usedInScenario "S4" ; :writtenBy "greffier" .
:SMF  a owl:Class ; rdfs:subClassOf :NetworkFunction ; rdfs:label "SMF"@fr ;
    rdfs:comment "Session Management Function. Deployee (PFCP et GTP-U lies a 127.0.0.1, aucun UPF associe). Declare PLMN et tranches : sert S4."@fr ;
    :layer "L4" ; :usedInScenario "S4" ; :writtenBy "greffier" .
:UPF  a owl:Class ; rdfs:subClassOf :NetworkFunction ; rdfs:label "UPF"@fr ;
    rdfs:comment "User Plane Function. NON DEPLOYEE sur le banc (besoin de NET_ADMIN et /dev/net/tun). Classe presente pour la completude 3GPP, aucun individu."@fr ;
    :layer "L4" ; :usedInScenario "S3" ; :writtenBy "greffier" .
:NRF  a owl:Class ; rdfs:subClassOf :NetworkFunction ; rdfs:label "NRF"@fr ;
    rdfs:comment "Network Repository Function : annuaire ou toutes les NF s'enregistrent. Toutes en dependent (:dependsOnNF) : une NRF touchee touche tout le coeur (S3)."@fr ;
    :layer "L4" ; :usedInScenario "S3" , "S4" ; :writtenBy "greffier" .
:AUSF a owl:Class ; rdfs:subClassOf :NetworkFunction ; rdfs:label "AUSF"@fr ;
    rdfs:comment "Authentication Server Function. Deployee."@fr ;
    :layer "L4" ; :usedInScenario "S3" ; :writtenBy "greffier" .
:UDM  a owl:Class ; rdfs:subClassOf :NetworkFunction ; rdfs:label "UDM"@fr ;
    rdfs:comment "Unified Data Management. Deployee ; depend du Secret udm-keys (cles SUCI, hors Git) : c'est la NF touchee par S2 -> S3."@fr ;
    :layer "L4" ; :usedInScenario "S3" ; :writtenBy "greffier" .
:UDR  a owl:Class ; rdfs:subClassOf :NetworkFunction ; rdfs:label "UDR"@fr ;
    rdfs:comment "Unified Data Repository. Deployee (base MongoDB)."@fr ;
    :layer "L4" ; :usedInScenario "S3" ; :writtenBy "greffier" .
:PCF  a owl:Class ; rdfs:subClassOf :NetworkFunction ; rdfs:label "PCF"@fr ;
    rdfs:comment "Policy Control Function. Deployee (base MongoDB)."@fr ;
    :layer "L4" ; :usedInScenario "S3" ; :writtenBy "greffier" .
:NSSF a owl:Class ; rdfs:subClassOf :NetworkFunction ; rdfs:label "NSSF"@fr ;
    rdfs:comment "Network Slice Selection Function. Deployee."@fr ;
    :layer "L4" ; :usedInScenario "S3" ; :writtenBy "greffier" .
:BSF  a owl:Class ; rdfs:subClassOf :NetworkFunction ; rdfs:label "BSF"@fr ;
    rdfs:comment "Binding Support Function. Deployee ; cible proposee pour S1 (nodeSelector ajoute par toi dans bsf.yaml)."@fr ;
    :layer "L4" ; :usedInScenario "S1" , "S3" ; :writtenBy "greffier" .

[] a owl:AllDisjointClasses ;
    owl:members ( :AMF :SMF :UPF :NRF :AUSF :UDM :UDR :PCF :NSSF :BSF ) .

:NetworkInterface a owl:Class ;
    rdfs:label "interface reseau d'une NF"@fr , "Network interface"@en ;
    rdfs:comment """Un point d'acces expose par une NF, reduit a trois faits : nom (SBI, N2, N4…),
port et protocole. Pas de modelisation fine des procedures N2/N3/N4. Sert a
relier une NF a ce que Kubernetes expose ou filtre (Service, NetworkPolicy) dans
la version complete. IRI : <IRI de la NF>/interface/<nom>."""@fr ;
    owl:disjointWith :KubernetesResource , :NetworkFunction ;
    :layer "L4" ;
    :usedInScenario "S3" ;
    :writtenBy "greffier" .

:PLMN a owl:Class ;
    rdfs:label "PLMN"@fr , "Public Land Mobile Network"@en ;
    rdfs:comment """Identifiant d'un reseau mobile (MCC + MNC). Ici 999/70, code de test. Un seul
individu par couple (IRI .../res/_/PLMN/999-70) : deux NF du meme reseau
pointent vers le meme individu, deux PLMN differents se voient tout de suite (S4)."""@fr ;
    owl:disjointWith :KubernetesResource , :NetworkFunction , :NetworkInterface ;
    :layer "L4" ;
    :usedInScenario "S4" ;
    :writtenBy "greffier" .

:Slice a owl:Class ;
    rdfs:label "tranche de reseau (S-NSSAI)"@fr , "Network slice"@en ;
    rdfs:comment """Tranche de reseau identifiee par son S-NSSAI (SST, et SD optionnel). Ici SST 1.
Sert S4 : une tranche servie par le SMF doit aussi l'etre par l'AMF."""@fr ;
    owl:disjointWith :KubernetesResource , :NetworkFunction , :NetworkInterface , :PLMN ;
    :layer "L4" ;
    :usedInScenario "S4" ;
    :writtenBy "greffier" .

:realizedBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "realisee par"@fr ;
    rdfs:domain :NetworkFunction ;
    rdfs:range :Deployment ;
    rdfs:comment """Pont L4 -> L2 : le Deployment qui fait tourner la NF. Tire du label
sylvatwin.orange.com/nf pose dans Git (pas d'heuristique sur le nom). C'est par
ce lien qu'une derive Kubernetes (S0, S1, S2) remonte jusqu'a la NF (S3)."""@fr ;
    :k8sSource "Deployment.metadata.labels[sylvatwin.orange.com/nf]" ;
    :layer "L4" ;
    :usedInScenario "S3" ;
    :writtenBy "greffier" .

:dependsOnNF a owl:ObjectProperty ;
    rdfs:label "depend de la NF"@fr ;
    rdfs:domain :NetworkFunction ;
    rdfs:range :NetworkFunction ;
    rdfs:comment """Dependance DECLAREE dans la configuration : la NF appelle cette autre NF.
Ici, toutes appellent la NRF (sbi.client.nrf.uri). Permet de propager l'impact
(S3) : une NRF touchee rend fragiles toutes les NF qui en dependent. Non
transitive en OWL (chemin SPARQL :dependsOnNF+ dans les regles)."""@fr ;
    :k8sSource "ConfigMap <nf>-config : <nf>.sbi.client.nrf[].uri (et scp)" ;
    :layer "L4" ;
    :usedInScenario "S3" ;
    :writtenBy "greffier" .

:exposesInterface a owl:ObjectProperty ;
    rdfs:label "expose l'interface"@fr ;
    rdfs:domain :NetworkFunction ;
    rdfs:range :NetworkInterface ;
    rdfs:comment "Interface ouverte par la NF, telle que declaree dans sa configuration."@fr ;
    :k8sSource "ConfigMap <nf>-config : sbi.server, ngap.server, pfcp.server, gtpu.server" ;
    :layer "L4" ;
    :usedInScenario "S3" ;
    :writtenBy "greffier" .

:hasPlmn a owl:ObjectProperty ;
    rdfs:label "sert le PLMN"@fr ;
    rdfs:domain :NetworkFunction ;
    rdfs:range :PLMN ;
    rdfs:comment """PLMN declare dans la configuration de la NF. Seules les NF qui en declarent un
l'ont (ici NRF, AMF, SMF). Le greffier N'INVENTE PAS de PLMN pour les autres :
UDM n'en declare pas (Open5GS prend alors une valeur par defaut, non observee).
S4 compare les PLMN des NF qui en declarent."""@fr ;
    :k8sSource "ConfigMap : nrf.serving[].plmn_id ; amf.plmn_support[].plmn_id ; smf.info[].tai[].plmn_id" ;
    :layer "L4" ;
    :usedInScenario "S4" ;
    :writtenBy "greffier" .

:servesSlice a owl:ObjectProperty ;
    rdfs:label "sert la tranche"@fr ;
    rdfs:domain :NetworkFunction ;
    rdfs:range :Slice ;
    rdfs:comment "Tranche (S-NSSAI) declaree dans la configuration de la NF (ici AMF et SMF : SST 1). S4."@fr ;
    :k8sSource "ConfigMap : amf.plmn_support[].s_nssai ; smf.info[].s_nssai" ;
    :layer "L4" ;
    :usedInScenario "S4" ;
    :writtenBy "greffier" .

:nfName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nom de la NF"@fr ;
    rdfs:domain :NetworkFunction ;
    rdfs:range xsd:string ;
    rdfs:comment "Valeur du label sylvatwin.orange.com/nf (amf, udm…)."@fr ;
    :layer "L4" ; :usedInScenario "S3" , "S4" ; :writtenBy "greffier" .

:interfaceName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nom de l'interface"@fr ;
    rdfs:domain :NetworkInterface ;
    rdfs:range xsd:string ;
    rdfs:comment "SBI, N2 (NGAP), N4 (PFCP), N3 (GTP-U)…"@fr ;
    :layer "L4" ; :usedInScenario "S3" ; :writtenBy "greffier" .

:port a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "port"@fr ;
    rdfs:domain :NetworkInterface ;
    rdfs:range xsd:integer ;
    rdfs:comment "Port d'ecoute (7777 pour la SBI ici)."@fr ;
    :layer "L4" ; :usedInScenario "S3" ; :writtenBy "greffier" .

:protocol a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "protocole"@fr ;
    rdfs:domain :NetworkInterface ;
    rdfs:range xsd:string ;
    rdfs:comment "TCP, UDP ou SCTP."@fr ;
    :layer "L4" ; :usedInScenario "S3" ; :writtenBy "greffier" .

:mcc a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "MCC"@fr ; rdfs:domain :PLMN ; rdfs:range xsd:string ;
    rdfs:comment "Mobile Country Code, en chaine (les zeros de tete comptent)."@fr ;
    :layer "L4" ; :usedInScenario "S4" ; :writtenBy "greffier" .

:mnc a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "MNC"@fr ; rdfs:domain :PLMN ; rdfs:range xsd:string ;
    rdfs:comment "Mobile Network Code, en chaine (\"70\" et \"070\" sont differents en 3GPP)."@fr ;
    :layer "L4" ; :usedInScenario "S4" ; :writtenBy "greffier" .

:sst a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "SST"@fr ; rdfs:domain :Slice ; rdfs:range xsd:integer ;
    rdfs:comment "Slice/Service Type (1 = eMBB)."@fr ;
    :layer "L4" ; :usedInScenario "S4" ; :writtenBy "greffier" .

# =============================================================================
# 9. NOUVELLES DERIVES (ecrites UNIQUEMENT par le juge)
# =============================================================================

:FunctionImpactDrift a owl:Class ; rdfs:subClassOf :Drift ;
    rdfs:label "fonction reseau touchee (inter-couches)"@fr , "Function impact drift"@en ;
    rdfs:comment """S3 : une derive constatee sur une ressource Kubernetes (S0, S1 ou S2) touche une
fonction reseau, directement (via :realizedBy) ou par dependance (:dependsOnNF+).
Exemple : Secret udm-keys supprime (S2) -> NF UDM touchee. Elle ne remplace pas
la derive d'origine : elle la rattache (:causedBy) et designe la NF (:affectsFunction)."""@fr ;
    :layer "transverse" ;
    :usedInScenario "S3" ;
    :writtenBy "juge" .

:InterNFConsistencyDrift a owl:Class ; rdfs:subClassOf :Drift ;
    rdfs:label "incoherence entre fonctions reseau"@fr , "Inter-NF consistency drift"@en ;
    rdfs:comment """S4 : deux NF du meme coeur declarent des valeurs incompatibles (PLMN different,
ou tranche servie par le SMF mais absente de l'AMF). Chaque objet est conforme a
son Git : ni Flux, ni Kyverno, ni kubectl diff ne le voient."""@fr ;
    :layer "transverse" ;
    :usedInScenario "S4" ;
    :writtenBy "juge" .

:GitOpsSyncDrift a owl:Class ; rdfs:subClassOf :Drift ;
    rdfs:label "livraison GitOps bloquee"@fr , "GitOps sync drift"@en ;
    rdfs:comment """S5 : la Kustomization n'applique pas la revision de sa source
(desiredRevision != actualRevision), ou est suspendue. Le cluster cible n'est
plus pilote par Git : toutes les ressources gerees heritent du risque."""@fr ;
    :layer "transverse" ;
    :usedInScenario "S5" ;
    :writtenBy "juge" .

:MachineNodeMismatchDrift a owl:Class ; rdfs:subClassOf :Drift ;
    rdfs:label "Machine et Node incoherents (Cluster API)"@fr , "Machine/Node mismatch drift"@en ;
    rdfs:comment """S6 : une Machine CAPI hors creation n'a pas de Node, ou un Node du cluster reel
n'est revendique par aucune Machine du Cluster qui le decrit. La description CAPI
et le cluster reel ne correspondent plus."""@fr ;
    :layer "transverse" ;
    :usedInScenario "S6" ;
    :writtenBy "juge" .

:affectsFunction a owl:ObjectProperty ;
    rdfs:label "touche la fonction"@fr ;
    rdfs:domain :Drift ;
    rdfs:range :NetworkFunction ;
    rdfs:comment """NF touchee par une derive (S3, S4). Distincte de :affects, dont la portee est
une ressource Kubernetes. Ecrit uniquement par les regles."""@fr ;
    :layer "transverse" ;
    :usedInScenario "S3" , "S4" ;
    :writtenBy "juge" .

:causedBy a owl:ObjectProperty ;
    rdfs:label "causee par"@fr ;
    rdfs:domain :Drift ;
    rdfs:range :Drift ;
    rdfs:comment """Chaine causale entre derives : une FunctionImpactDrift est causee par la derive
Kubernetes d'origine. C'est la trace inter-couches. Ecrit uniquement par les regles."""@fr ;
    :layer "transverse" ;
    :usedInScenario "S3" ;
    :writtenBy "juge" .

:impactPath a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "chemin d'impact"@fr ;
    rdfs:domain :Drift ;
    rdfs:range xsd:string ;
    rdfs:comment """Comment la derive d'origine atteint la NF : "direct" (la NF est realisee par la
ressource derivee, ou par le Deployment d'un Pod derive), "dependance" (la NF
depend d'une NF touchee, :dependsOnNF+), "flux" (la Kustomization qui gere son
Deployment est bloquee), "infrastructure" (son Pod tourne sur un Node en derive
Cluster API). Ecrit uniquement par les regles."""@fr ;
    :layer "transverse" ;
    :usedInScenario "S3" ;
    :writtenBy "juge" .

# Disjonctions complementaires (ajout v1.1.0, sans redefinir les termes v1.0.0) :
# une derive, un label, un cluster reel, une NF, une interface, un PLMN et une
# tranche sont des choses de natures differentes.
[] a owl:AllDisjointClasses ;
    owl:members ( :Drift :Label :KubernetesCluster :NetworkFunction :NetworkInterface :PLMN :Slice ) .

# #############################################################################
# v1.2.0 — SYNCHRONISATION : portee d'observation (P3), parametres Flux,
# cycle de vie des derives. AJOUTS uniquement.
# #############################################################################

# --- Portee et statut d'observation, portes par le cluster reel (greffier) ----
# Ne PAS utiliser :observedAt ni :clusterName sur un KubernetesCluster (domaine
# KubernetesResource, disjointe) : d'ou des proprietes dediees.

:observationStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "statut d'observation"@fr ;
    rdfs:domain :KubernetesCluster ;
    rdfs:range xsd:string ;
    rdfs:comment """Resultat de la derniere tentative d'observation du cluster : "ok", "unreachable"
(API injoignable) ou "forbidden" (droits refuses). Si ce n'est pas "ok", les faits
du cluster sont ceux du dernier instantane reussi : une ABSENCE de fait ne prouve
alors rien. Les regles fondees sur l'absence (S2, S6) l'exigent "ok" (garde P3)."""@fr ;
    :k8sSource "resultat de la synchronisation du greffier" ;
    :layer "L1" ; :usedInScenario "S2" , "S6" ; :writtenBy "greffier" .

:lastSyncTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "derniere synchronisation reussie"@fr ;
    rdfs:domain :KubernetesCluster ;
    rdfs:range xsd:dateTime ;
    rdfs:comment """Instant de la derniere observation complete et reussie du cluster. Base de
l'age de l'information par cluster (verdict date)."""@fr ;
    :layer "L1" ; :usedInScenario "S2" , "S5" , "S6" ; :writtenBy "greffier" .

:ObservationScope a owl:Class ;
    rdfs:label "portee d'observation"@fr , "Observation scope"@en ;
    rdfs:comment """Ce que le greffier a reellement observe dans un cluster : un type de ressource
(Kind) dans un namespace ("*" = tous). Une regle qui conclut a l'absence d'un
objet doit verifier que son type et son namespace sont dans la portee (garde P3) :
hors portee, l'absence ne veut rien dire (monde ouvert)."""@fr ;
    owl:disjointWith :KubernetesResource , :KubernetesCluster , :Drift , :Label ,
        :NetworkFunction , :NetworkInterface , :PLMN , :Slice ;
    :layer "L1" ; :usedInScenario "S2" , "S6" ; :writtenBy "greffier" .

:hasObservationScope a owl:ObjectProperty ;
    rdfs:label "a pour portee d'observation"@fr ;
    rdfs:domain :KubernetesCluster ;
    rdfs:range :ObservationScope ;
    rdfs:comment "Portees observees dans ce cluster au dernier cycle."@fr ;
    :layer "L1" ; :usedInScenario "S2" , "S6" ; :writtenBy "greffier" .

:scopeKind a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "type observe"@fr ;
    rdfs:domain :ObservationScope ;
    rdfs:range xsd:string ;
    rdfs:comment "Nom local de la classe observee (\"Secret\", \"Node\", \"Machine\"…)."@fr ;
    :layer "L1" ; :usedInScenario "S2" , "S6" ; :writtenBy "greffier" .

:scopeNamespace a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "namespace observe"@fr ;
    rdfs:domain :ObservationScope ;
    rdfs:range xsd:string ;
    rdfs:comment "Namespace observe, ou \"*\" pour tous (et pour les types sans namespace)."@fr ;
    :layer "L1" ; :usedInScenario "S2" , "S6" ; :writtenBy "greffier" .

# --- Parametres Flux (greffier) : bases de l'horizon de convergence ----------

:reconcileInterval a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "intervalle de reconciliation"@fr ;
    rdfs:domain :CustomResource ;
    rdfs:range xsd:decimal ;
    rdfs:comment """spec.interval de la Kustomization, HelmRelease ou GitRepository, EN SECONDES
(decimal plutot que xsd:duration : comparable en SPARQL sans extension). Sert au
juge a calculer l'horizon de convergence (derive attendue ou persistante)."""@fr ;
    :k8sSource "spec.interval" ;
    :layer "L3" ; :usedInScenario "S0" , "S5" ; :writtenBy "greffier" .

:reconcileTimeout a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "delai maximal de reconciliation"@fr ;
    rdfs:domain :CustomResource ;
    rdfs:range xsd:decimal ;
    rdfs:comment "spec.timeout, en secondes. Ajoute a l'intervalle dans l'horizon."@fr ;
    :k8sSource "spec.timeout" ;
    :layer "L3" ; :usedInScenario "S0" , "S5" ; :writtenBy "greffier" .

:retryInterval a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "intervalle de nouvelle tentative"@fr ;
    rdfs:domain :CustomResource ;
    rdfs:range xsd:decimal ;
    rdfs:comment "spec.retryInterval, en secondes (apres un echec de reconciliation)."@fr ;
    :k8sSource "spec.retryInterval" ;
    :layer "L3" ; :usedInScenario "S5" ; :writtenBy "greffier" .

:driftDetectionMode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "mode de detection de derive Helm"@fr ;
    rdfs:domain :HelmRelease ;
    rdfs:range xsd:string ;
    rdfs:comment """spec.driftDetection.mode : "enabled" (Flux corrige), "warn" (Flux signale sans
corriger : horizon infini) ou "disabled" (absent). Observe : 2 HelmReleases en
"warn" sur le management."""@fr ;
    :k8sSource "HelmRelease.spec.driftDetection.mode" ;
    :layer "L3" ; :usedInScenario "S5" ; :writtenBy "greffier" .

# --- Cycle de vie des derives (juge) -------------------------------------------

:firstDetectedAt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "premiere detection"@fr ;
    rdfs:domain :Drift ;
    rdfs:range xsd:dateTime ;
    rdfs:comment """Premier cycle ou la derive (meme IRI stable) a ete constatee. Conserve d'un cycle
a l'autre dans le graphe d'historique du juge (le graphe des faits, lui, est
reconstruit). Donne l'age de la derive."""@fr ;
    :layer "transverse" ; :usedInScenario "S0" , "S2" , "S5" ; :writtenBy "juge" .

:lastDetectedAt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "derniere detection"@fr ;
    rdfs:domain :Drift ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "Dernier cycle ou la derive etait encore constatee."@fr ;
    :layer "transverse" ; :usedInScenario "S0" , "S2" , "S5" ; :writtenBy "juge" .

:resolvedAt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "resolue a"@fr ;
    rdfs:domain :Drift ;
    rdfs:range xsd:dateTime ;
    rdfs:comment """Premier cycle ou la derive n'est plus constatee (sur information fraiche). La
difference resolvedAt - firstDetectedAt mesure le delai reel de correction."""@fr ;
    :layer "transverse" ; :usedInScenario "S0" , "S5" ; :writtenBy "juge" .

:convergenceHorizon a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "horizon de convergence"@fr ;
    rdfs:domain :Drift ;
    rdfs:range xsd:decimal ;
    rdfs:comment """Delai, en secondes, au-dela duquel la derive n'est plus "attendue" (Flux aurait
du la corriger) : interval + timeout de la Kustomization qui gere la ressource.
ABSENT quand aucun outil ne la corrigera (ressource hors Git, Kustomization
suspendue, HelmRelease en "warn") : l'horizon est alors infini et la derive est
confirmee des sa detection. Calcule par une regle, jamais par l'operateur."""@fr ;
    :layer "transverse" ; :usedInScenario "S0" , "S2" , "S5" ; :writtenBy "juge" .

# #############################################################################
# v1.2.0 -> v1.3.0 — AJOUTS (article complet, 10/11/2026) :
#   - Watch temoin (P1) + age de l'information A_c(t) (partie 2)
#   - horizon de convergence des ConvergenceDrift : progressDeadlineSeconds du
#     Deployment, PAS celui de Flux (correction partie 3, limite notee le 09/11)
#   - ConfigMap (classe), mountsConfigMap, lastModifiedAt -> StaleConfigDrift (D4)
#   - SCP (sous-classe de NetworkFunction)
# Rien ne redefinit ni ne retire un terme existant.
# #############################################################################

# --- Watch temoin et age de l'information (partie 2) -------------------------

:witnessLeaseName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nom de la Lease temoin"@fr ;
    rdfs:domain :KubernetesCluster ; rdfs:range xsd:string ;
    rdfs:comment """Nom de la Lease de nœud (kube-node-lease) surveillee par Watch comme temoin de
vie du canal d'observation. On ne surveille PAS les Lease par defaut (exigence
temps reel, partie 1) : seule CETTE Lease precise est un Watch dedie, minimal."""@fr ;
    :k8sSource "coordination.k8s.io/v1 Lease, namespace kube-node-lease" ;
    :layer "L1" ; :usedInScenario "fraicheur" ; :writtenBy "greffier" .

:lastWitnessRenewTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dernier renouvellement du temoin"@fr ;
    rdfs:domain :KubernetesCluster ; rdfs:range xsd:dateTime ;
    rdfs:comment """u_c(t) : instant du dernier evenement Watch recu sur la Lease temoin. Sert a
calculer l'age de l'information A_c(t) = t - u_c(t) (juge), independamment de
:lastSyncTime (qui date la derniere RECONSTRUCTION du graphe, pas la derniere
preuve de vie du canal)."""@fr ;
    :k8sSource "Lease.spec.renewTime, evenement Watch" ;
    :layer "L1" ; :usedInScenario "fraicheur" ; :writtenBy "greffier" .

:freshnessHorizon a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "horizon de fraicheur (theta)"@fr ;
    rdfs:domain :KubernetesCluster ; rdfs:range xsd:decimal ;
    rdfs:comment """H_frais (theta), en secondes : au-dela de A_c(t), le canal vers ce cluster est
declare perime (tous ses verdicts deviennent UnknownVerdict). Parametre de
deploiement (defaut 3 x periode de renouvellement du temoin, soit 30 s pour un
kubelet standard dont la Lease se renouvelle toutes les 10 s)."""@fr ;
    :layer "L1" ; :usedInScenario "fraicheur" ; :writtenBy "greffier" .

# --- Horizon de convergence propre a ConvergenceDrift (correction partie 3) --

:progressDeadlineSeconds a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "delai de progression (Kubernetes)"@fr ;
    rdfs:domain :Deployment ; rdfs:range xsd:decimal ;
    rdfs:comment """spec.progressDeadlineSeconds (defaut Kubernetes : 600 s si absent). C'est le
delai que KUBERNETES lui-meme accorde a un Deployment pour converger avant de le
marquer en echec de progression. Sert d'horizon de convergence pour
ConvergenceDrift (PAS l'horizon Flux interval+timeout : correction du 10/11/2026,
le constat du 09/11 etait une approximation volontairement grossiere - voir
rapport, campagne du 09/11)."""@fr ;
    :k8sSource "Deployment.spec.progressDeadlineSeconds" ;
    :usedInScenario "S0" ; :writtenBy "greffier" .

# --- ConfigMap et StaleConfigDrift (D4, partie 3) -----------------------------

:ConfigMap a owl:Class ; rdfs:subClassOf :KubernetesResource ;
    rdfs:label "ConfigMap"@fr , "ConfigMap"@en ;
    rdfs:comment """Une ConfigMap Kubernetes. Comme pour Secret, le jumeau n'en stocke JAMAIS le
CONTENU : seulement son existence et l'instant de sa derniere modification
(:lastModifiedAt), pour detecter D4 (un Pod demarre avant la derniere mise a
jour de la ConfigMap qu'il monte -> il tourne avec une config perimee)."""@fr ;
    :usedInScenario "D4" ; :writtenBy "greffier" .

[] a owl:AllDisjointClasses ;
    owl:members ( :ConfigMap :Namespace :Deployment :ReplicaSet :Pod :Node :Secret :CustomResource ) .

:mountsConfigMap a owl:ObjectProperty ;
    rdfs:label "monte la ConfigMap"@fr ;
    rdfs:domain :Deployment ; rdfs:range :ConfigMap ;
    rdfs:comment """Le pod template du Deployment monte cette ConfigMap en volume (meme perimetre
que :referencesSecret, mais pour les ConfigMaps). Base de D4 : comparer
:lastModifiedAt de la ConfigMap a :startedAt du Pod qui en depend (via le meme
Deployment)."""@fr ;
    :k8sSource "Deployment.spec.template.spec.volumes[].configMap.name" ;
    :usedInScenario "D4" ; :writtenBy "greffier" .

:lastModifiedAt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "derniere modification"@fr ;
    rdfs:domain :ConfigMap ; rdfs:range xsd:dateTime ;
    rdfs:comment """Instant de la derniere ecriture de la ConfigMap, lu dans metadata.managedFields
(le plus recent des champs 'time', tous gestionnaires confondus). Fait brut :
le greffier ne sait pas SI le Pod a rechargé cette version, seulement QUAND elle
a change. C'est la regle (juge) qui compare a :startedAt du Pod."""@fr ;
    :k8sSource "ConfigMap.metadata.managedFields[].time (max)" ;
    :usedInScenario "D4" ; :writtenBy "greffier" .

:startedAt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "demarre a"@fr ;
    rdfs:domain :Pod ; rdfs:range xsd:dateTime ;
    rdfs:comment "Pod.status.startTime : instant ou le pod a demarre (et donc lu sa configuration montee UNE FOIS, au demarrage)."@fr ;
    :k8sSource "Pod.status.startTime" ;
    :usedInScenario "D4" ; :writtenBy "greffier" .

:StaleConfigDrift a owl:Class ; rdfs:subClassOf :Drift ;
    rdfs:label "configuration perimee (D4)"@fr , "Stale config drift"@en ;
    rdfs:comment """D4 : un Pod a demarre AVANT la derniere modification de la ConfigMap qu'il
monte (via son Deployment). Le pod tourne donc, EN MEMOIRE, avec une version
plus ancienne que celle que l'API renvoie. Flux ne le voit pas : la ConfigMap
EST a jour dans l'API, conforme a Git ; seul le processus en memoire ne l'est
pas. Confirme par exec le 09/11/2026 sur nrf et smf (campagne S4-a/S4-b, pods
non redemarres apres la correction par Flux)."""@fr ;
    :layer "transverse" ; :usedInScenario "D4" ; :writtenBy "juge" .

# --- SCP (partie 3 : classe manquante trouvee lors de l'audit du 09/11) ------

:SCP a owl:Class ; rdfs:subClassOf :NetworkFunction ; rdfs:label "SCP"@fr ;
    rdfs:comment """Service Communication Proxy. Deployee sur le banc (ns sylvatwin-5gc) mais
ABSENTE de la v1.2.0 : sans classe, elle n'apparaissait dans aucun
:affectsFunction (trouve lors de l'audit de l'etat sain du 09/11/2026, avant
d'ajouter cette classe)."""@fr ;
    :layer "L4" ; :usedInScenario "S3" ; :writtenBy "greffier" .

[] a owl:AllDisjointClasses ;
    owl:members ( :AMF :SMF :UPF :NRF :AUSF :UDM :UDR :PCF :NSSF :BSF :SCP ) .
