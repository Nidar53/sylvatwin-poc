    :desiredRevision "test@sha1:39f14dedee3535afe74726e97330e4eacf34ed8a" ;
    :desiredReplicas 1 ;          # Git : usecase/5gc/udm.yaml, spec.replicas
    :observedSpecReplicas 1 ;     # cluster : spec.replicas
    :actualReplicas 1 ;           # cluster : status.readyReplicas
    :referencesSecret <sylvatwin-5gc/Secret/udm-keys> ;   # volumes[udm-keys].secret.secretName
    :observedAt "2026-11-08T13:40:53Z"^^xsd:dateTime .

# --- ReplicaSet (ownerReferences -> Deployment/udm, controller=true) ----------
<sylvatwin-5gc/ReplicaSet/udm-7cf6c5b78d> a :ReplicaSet ;
